rules_version = '2';

// Reglas para el MVP de TalentFlow (sin autenticación).
// - Solo se expone la colección `candidatos`.
// - Lectura pública y creación pública CON validación de estructura y tipos.
// - No se permite editar ni eliminar.
// - Todo lo demás de la base de datos queda cerrado.
// Las listas de cargos/niveles/habilidades deben coincidir con src/app/data/opciones.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    function camposCandidato() {
      return ['nombres', 'correo', 'telefono', 'fechaNacimiento', 'cargo', 'nivelAcademico',
              'experienciaAnios', 'modalidad', 'habilidades', 'fechaDisponibilidad',
              'aspiracionSalarial', 'resumen', 'consentimiento', 'creadoEn'];
    }

    function esFecha(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function esCandidatoValido(d) {
      return d.keys().hasOnly(camposCandidato())
        && d.keys().hasAll(camposCandidato())
        && d.nombres is string && d.nombres.size() >= 3 && d.nombres.size() <= 80
        && d.correo is string && d.correo.matches('^[^@ ]+@[^@ ]+[.][^@ ]{2,}$')
        && d.telefono is string && d.telefono.matches('^[+]?[0-9]{7,15}$')
        && esFecha(d.fechaNacimiento)
        && d.cargo in ['Desarrollador móvil', 'Analista de datos', 'Diseñador UX/UI', 'Soporte TI', 'Tester QA']
        && d.nivelAcademico in ['Bachillerato', 'Tecnología', 'Tercer nivel', 'Posgrado']
        && d.experienciaAnios is int && d.experienciaAnios >= 0 && d.experienciaAnios <= 50
        && d.modalidad in ['Presencial', 'Híbrida', 'Remota']
        && d.habilidades is list && d.habilidades.size() >= 1
        && d.habilidades.hasOnly(['Angular', 'Ionic', 'JavaScript', 'Python', 'SQL', 'Git', 'Firebase'])
        && esFecha(d.fechaDisponibilidad)
        && (d.aspiracionSalarial is int || d.aspiracionSalarial is float)
        && d.aspiracionSalarial > 0 && d.aspiracionSalarial <= 100000
        && d.resumen is string && d.resumen.size() >= 30 && d.resumen.size() <= 1000
        && d.consentimiento == true
        && d.creadoEn == request.time;
    }

    match /candidatos/{candidatoId} {
      allow get, list: if true;
      allow create: if esCandidatoValido(request.resource.data);
      allow update, delete: if false;
    }

    // Cualquier otra colección: cerrada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
